parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property FastD\\Swoole\\Event\\SwooleEvent\:\:\$ports\.$#'
			identifier: property.notFound
			count: 4
			path: src/Listener/Server/WorkerListener.php

		-
			message: '#^Call to an undefined method Psr\\EventDispatcher\\ListenerProviderInterface\:\:addListener\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Process.php

		-
			message: '#^Call to an undefined method Swoole\\Coroutine\\Socket\:\:isConnected\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Process/IPC/Socket.php

		-
			message: '#^Class Swoole\\Coroutine\\Socket constructor invoked with 1 parameter, 2\-3 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Process/IPC/Socket.php

		-
			message: '#^Class FastD\\Swoole\\Process\\Worker has an uninitialized readonly property \$process\. Assign it in the constructor\.$#'
			identifier: property.uninitializedReadonly
			count: 1
			path: src/Process/Worker.php

		-
			message: '#^Readonly property FastD\\Swoole\\Process\\Worker\:\:\$process is assigned outside of the constructor\.$#'
			identifier: property.readOnlyAssignNotInConstructor
			count: 1
			path: src/Process/Worker.php

		-
			message: '#^Call to an undefined method FastD\\Event\\EventDispatcher\:\:forward\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Server.php

		-
			message: '#^Call to an undefined method Psr\\EventDispatcher\\ListenerProviderInterface\:\:addListener\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Server.php

		-
			message: '#^PHPDoc tag @param for parameter \$eventListener with type FastD\\Event\\EventListenerInterface is not subtype of native type FastD\\Swoole\\Listener\\SwooleEventListener\.$#'
			identifier: parameter.phpDocType
			count: 1
			path: src/Server.php
